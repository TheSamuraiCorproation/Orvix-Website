# Netlify. Build tooling and working notes live in the publish folder and
# would otherwise be served to anyone who guessed the path.
#
# The trailing "!" forces the rule. Without it Netlify serves a file that
# exists at the path in preference to the rule (shadowing), so none of
# these were actually hidden.
/tools/*                    /404.html  404!
/README.md                  /404.html  404!
/BUILD_NOTES.txt            /404.html  404!
/images/CREDITS.txt         /404.html  404!
/assets/ar-dictionary.json  /404.html  404!
/netlify.toml               /404.html  404!
/.github/*                  /404.html  404!

